# Server
PORT=3002
NODE_ENV=development
SERVICE_NAME=transaction-service

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AWS
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:pix-transactions

# DynamoDB Tables
TRANSACTIONS_TABLE=pix-banking-transactions
ACCOUNTS_TABLE=pix-banking-accounts
NOTIFICATIONS_TABLE=pix-banking-notifications
PIX_KEYS_TABLE=pix-banking-pixkeys

# Logging
LOG_LEVEL=info