# Service
NODE_ENV=development
SERVICE_NAME=settlement-service

# AWS
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB Tables
TRANSACTIONS_TABLE=pix-banking-transactions
ACCOUNTS_TABLE=pix-banking-accounts
NOTIFICATIONS_TABLE=pix-banking-notifications

# AWS Messaging
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pix-settlement-queue
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:pix-transactions

# SQS Configuration
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=20
SQS_VISIBILITY_TIMEOUT=300

# Settlement Configuration
SETTLEMENT_BATCH_SIZE=50
SETTLEMENT_INTERVAL_SECONDS=21600
CRON_SCHEDULE=0 */6 * * *